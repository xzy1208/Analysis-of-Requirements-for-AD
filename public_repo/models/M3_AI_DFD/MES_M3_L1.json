    "passes": 1,
    "prompt_summary": "Generate a single-pass Level 1 DFD refining the AEB branch of F3 (F3.1/F3.2/F3.3), balanced with the Level 0 parent, thresholds only from spec sections 7 and 8.",
    "self_review_performed": false
  },
  "elements": [
    {
      "id": "F3.1",
      "kind": "function",
      "name": "TTC_Computation",
      "responsibility": "Compute per-object TTC and report the minimum TTC with the number of objects considered.",
      "inputs": [
        {
          "name": "predicted_trajectories",
          "source": "F2"
        },
        {
          "name": "ego_state",
          "source": "F1"
        }
      ],
      "outputs": [
        {
          "name": "ttc_set",
          "consumers": [
            "F3.2"
          ]
        }
      ],
      "stores_read": [],
      "stores_written": [],
      "preconditions": [
        "predicted_trajectories.horizon >= 3.0",
        "ego_state.speed >= 0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "ttc_set.min_ttc >= 0 and ttc_set.min_ttc <= 3.0"
        },
        {
          "guard": "ttc_set.count = 0",
          "effect": "ttc_set.min_ttc = 0"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "Inputs F2/F1 resolve in parent MES_M3_L0.json."
    },
    {
      "id": "F3.2",
      "kind": "function",
      "name": "Risk_Classification",
      "responsibility": "Classify the situation into no-risk, caution and critical from the minimum TTC and raise the driver warning.",
      "inputs": [
        {
          "name": "ttc_set",
          "source": "F3.1"
        },
        {
          "name": "traffic_rules",
          "source": "D4"
        }
      ],
      "outputs": [
        {
          "name": "risk_level",
          "consumers": [
            "F3.3"
          ]
        },
        {
          "name": "warning",
          "consumers": [
            "E7"
          ]
        }
      ],
      "stores_read": [
        "D4"
      ],
      "stores_written": [],
      "preconditions": [
        "ttc_set.min_ttc >= 0",
        "traffic_rules.speed_limit >= 0"
      ],
      "postconditions": [
        {
          "guard": "ttc_set.min_ttc > 3.0",
          "effect": "risk_level = 0 and warning.active = 0 and warning.type = 0"
        },
        {
          "guard": "ttc_set.min_ttc <= 3.0 and ttc_set.min_ttc > 1.5",
          "effect": "risk_level = 1 and warning.active = 1 and warning.type = 1"
        },
        {
          "guard": "ttc_set.min_ttc <= 1.5",
          "effect": "risk_level = 2 and warning.active = 1 and warning.type = 2"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "Warning type: 0 none, 1 caution, 2 imminent collision; FCW timing N-2."
    },
    {
      "id": "F3.3",
      "kind": "function",
      "name": "Maneuver_Planning",
      "responsibility": "Produce cruise, deceleration and emergency-deceleration manoeuvres from the risk level, respecting driver intent.",
      "inputs": [
        {
          "name": "risk_level",
          "source": "F3.2"
        },
        {
          "name": "ego_state",
          "source": "F1"
        },
        {
          "name": "driver_intent",
          "source": "E3"
        },
        {
          "name": "route",
          "source": "F4"
        },
        {
          "name": "hd_map_segment",
          "source": "D1"
        }
      ],
      "outputs": [
        {
          "name": "manoeuvre",
          "consumers": [
            "F5"
          ]
        }
      ],
      "stores_read": [
        "D1"
      ],
      "stores_written": [],
      "preconditions": [
        "risk_level >= 0 and risk_level <= 2",
        "driver_intent.requested_speed >= 0",
        "route.path_length > 0"
      ],
      "postconditions": [
        {
          "guard": "risk_level = 0",
          "effect": "manoeuvre.type = 0 and manoeuvre.target_speed >= 0"
        },
        {
          "guard": "risk_level = 1",
          "effect": "manoeuvre.type = 1 and manoeuvre.required_decel > 0"
        },
        {
          "guard": "risk_level = 2",
          "effect": "manoeuvre.type = 2 and manoeuvre.required_decel >= 6.0 and manoeuvre.target_speed = 0"
        },
        {
          "guard": "risk_level = 2 and driver_intent.accelerate = 1",
          "effect": "manoeuvre.required_decel >= 6.0"
        },
        {
          "guard": "risk_level = 0 and driver_intent.accelerate = 1",
          "effect": "manoeuvre.target_speed >= driver_intent.requested_speed"
        },
        {
          "guard": "risk_level = 1 and driver_intent.accelerate = 1",
          "effect": "manoeuvre.target_speed >= driver_intent.requested_speed"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "A-1 emergency deceleration 6.0 m/s2 sized from N-3/N-4."
    }
  ],
