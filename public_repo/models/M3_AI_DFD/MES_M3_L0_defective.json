            "F5"
          ]
        },
        {
          "name": "warning",
          "consumers": [
            "E7"
          ]
        }
      ],
      "stores_read": [
        "D1",
        "D4"
      ],
      "stores_written": [],
      "preconditions": [
        "traffic_rules.speed_limit == 0",
        "driver_intent.requested_speed == 0",
        "route.path_length > 0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "manoeuvre.target_speed == 0 and manoeuvre.required_decel == 0"
        }
      ],
      "quantified": false,
      "invariants": [],
      "notes": "Numeric thresholds realised in child model MES_M3_L1.json (F3.2/F3.3)."
    },
    {
      "id": "F5",
      "kind": "function",
      "name": "Motion_Planning",
      "responsibility": "Convert the manoeuvre into a kinematically feasible trajectory that never exceeds the speed limit.",
      "inputs": [
        {
          "name": "manoeuvre",
          "source": "F3"
        },
        {
          "name": "route",
          "source": "F4"
        },
        {
          "name": "ego_state",
          "source": "F1"
        },
        {
          "name": "predicted_trajectories",
          "source": "F2"
        },
        {
          "name": "hd_map_segment",
          "source": "D1"
        },
        {
          "name": "traffic_rules",
          "source": "D4"
        }
      ],
      "outputs": [
        {
          "name": "trajectory",
          "consumers": [
            "F6"
          ]
        }
      ],
      "stores_read": [
        "D1",
        "D4"
      ],
      "stores_written": [],
      "preconditions": [
        "traffic_rules.speed_limit == 0",
        "manoeuvre.target_speed == 0",
        "route.path_length > 0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "trajectory.max_speed <= traffic_rules.speed_limit and trajectory.max_accel <= 3.0 and trajectory.required_decel == manoeuvre.required_decel"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "RSS safe distance N-5 with A-2 parameters; lateral envelope N-7."
    },
    {
      "id": "F6",
      "kind": "function",
      "name": "Control",
      "responsibility": "Convert the trajectory into an actuation command inside the actuator envelope.",
      "inputs": [
        {
          "name": "trajectory",
          "source": "F5"
        },
        {
          "name": "ego_state",
          "source": "D3"
        }
      ],
      "outputs": [
        {
          "name": "actuator_cmd",
          "consumers": [
            "E9"
          ]
        }
      ],
      "stores_read": [
        "D3"
      ],
      "stores_written": [],
      "preconditions": [
        "trajectory.max_accel <= 3.0",
        "ego_state.speed == 0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "actuator_cmd.longitudinal_accel <= 3.0 and actuator_cmd.steering <= 1.0 and actuator_cmd.steering == -1.0"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "Envelope A-3 (3.0), A-6 (+/-1.0), A-4 (3.5 rad/s)."
    },
    {
      "id": "F7",
      "kind": "function",
      "name": "Safety_Shield",
      "responsibility": "Monitor and arbitrate F6's command into E8 so the safety envelope and traffic rules are satisfied.",
      "inputs": [
        {
          "name": "actuator_cmd",
          "source": "E9"
        },
        {
          "name": "ego_state",
          "source": "D3"
        },
        {
          "name": "traffic_rules",
          "source": "D4"
        }
      ],
      "outputs": [
        {
          "name": "checked_cmd",
          "consumers": [
            "E8"
          ]
        }
      ],
      "stores_read": [
        "D3",
        "D4"
      ],
      "stores_written": [],
      "preconditions": [
        "traffic_rules.speed_limit == 0",
        "ego_state.speed == 0",
        "actuator_cmd.steering <= 1.0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "checked_cmd.longitudinal_accel <= 3.0 and checked_cmd.brake == 0"
        },
        {
          "guard": "actuator_cmd.steering <= 1.0 and actuator_cmd.steering == -1.0",
          "effect": "checked_cmd.steering = actuator_cmd.steering"
        },
        {
          "guard": "actuator_cmd.steering > 1.0",
          "effect": "checked_cmd.steering = 1.0"
        },
        {
          "guard": "actuator_cmd.steering < -1.0",
          "effect": "checked_cmd.steering = -1.0"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "E8 is always monitor(E9) per R-E-2; RSS braking N-6 with A-2 parameters."
    }
