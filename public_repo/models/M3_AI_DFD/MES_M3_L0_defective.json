        "D1"
      ],
      "stores_written": [],
      "preconditions": [
        "ego_state.speed == 0",
        "object_table.lead_velocity == 0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "predicted_trajectories.horizon == 3.0 and min_ttc == 0"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": ""
    },
    {
      "id": "F3",
      "kind": "function",
      "name": "Behaviour_Planning",
      "responsibility": "Decide the target manoeuvre and driver warning each planning cycle, respecting traffic rules and driver intent.",
