  "open_issues": [
    {
      "id": "OI-1",
      "issue": "Is the seven-function split of section 5 sufficient for the stated ODD? Is a separate driver-monitoring function needed for L2 handover?",
      "related_requirement": "R-SCOPE-1",
      "impact": "medium",
      "answer": "For this L1 behaviour model, driver attention and manual override are carried by E3 and the DriverOverride state; no extra function is introduced because R-L0-1 forbids it. A dedicated driver-monitoring function remains an L0 open issue."
    },
    {
      "id": "OI-2",
      "issue": "D3 is written by F1 but read by F6/F7; is that ownership acceptable?",
      "related_requirement": "D3",
      "impact": "low",
      "answer": "Acceptable: R-D-1/R-D-2 permit a named read, and the state machine only consumes ego_speed from D3 (T27) without writing it."
    },
    {
      "id": "OI-3",
      "issue": "The specification fixes thresholds while leaving timing unspecified; is a cycle-time requirement needed for the emergency branch?",
      "related_requirement": "R-L1-1",
      "impact": "high",
      "answer": "Yes. The state machine is event-driven and assumes min_ttc is refreshed every planning cycle; without an upper cycle-time bound the TTC bands cannot guarantee N-2. No cycle time is invented here."
    },
    {
      "id": "OI-4",
      "issue": "Is the AEB branch of F3 the right Level-1 refinement? Should Level 1 refine the F6/F7 actuation chain instead?",
      "related_requirement": "R-SCOPE-4",
      "impact": "medium",
      "answer": "The spec mandates R-SCOPE-4, so this model refines F3. A state machine is well suited to this choice because risk-level mode switching is inherently stateful; the F6/F7 chain is better expressed as data arbitration."
    },
    {
      "id": "OI-5",
      "issue": "FaultDegraded and Deactivated are synthetic states absent from the specification.",
      "related_requirement": "R-G-3",
      "impact": "medium",
      "answer": "Introduced to satisfy the requested exit/failure states. Their guards use only E1/E2 validity flags and E3 ODD status; their actions (retain last outputs, or fall back to cruise/none) are explicit modelling assumptions, not spec values."
    },
    {
      "id": "OI-6",
      "issue": "A-1 emergency deceleration (6.0 m/s2) exceeds the A-3 comfortable longitudinal limit (3.0 m/s2).",
      "related_requirement": "A-1",
      "impact": "medium",
      "answer": "The critical state treats A-1 as a safety exception enforced through F7 arbitration; the model leaves the two numerically unreconciled because the spec gives no priority rule."
    },
    {
      "id": "OI-7",
      "issue": "F3.1 reports obj_count = 0 while the spec leaves min_ttc undefined in that case.",
      "related_requirement": "F3.1",
      "impact": "low",
      "answer": "The state machine treats obj_count = 0 as no risk (T6/T7/T8) and leaves the classification of an empty object set for subsequent cycles open, without inventing a numeric min_ttc."
    }
  ]
}