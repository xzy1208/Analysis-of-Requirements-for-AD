  "model_id": "M1.1",
  "model_title": "Human-modelled SOFL baseline",
  "level": "L1",
  "parent_module": "System",
  "provenance": {
    "producer": "human",
    "llm_family": null,
    "generation_date": "2026-11-24",
    "passes": 1,
    "prompt_summary": "manual modelling with SOFL supporting tool from NL-RQ-ADAS-v1",
    "self_review_performed": false
  },
  "elements": [
    {
      "id": "ComputeTTC",
      "kind": "function",
      "name": "ComputeTTC",
      "responsibility": "Compute TTC for each predicted object and report the minimum TTC with the number of objects; report count 0 when no object is considered.",
      "inputs": [
        {
          "name": "predicted_trajectories",
          "source": ""
        },
        {
          "name": "ego_state",
          "source": ""
        }
      ],
      "outputs": [
        {
          "name": "ttc_values",
          "consumers": []
        }
      ],
      "stores_read": [],
      "stores_written": [],
      "preconditions": [
        "predicted_trajectories.min_ttc>=0 and ego_state.speed>=0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "ttc_values.min_ttc>=0"
        },
        {
          "guard": "predicted_trajectories.count=0",
          "effect": "ttc_values.count=0"
        },
        {
          "guard": "predicted_trajectories.count>0",
          "effect": "ttc_values.count=predicted_trajectories.count and ttc_values.min_ttc<=predicted_trajectories.min_ttc"
        }
      ],
      "quantified": false,
      "invariants": [],
      "notes": "extracted from validated SOFL artifacts",
      "level": "L1",
      "parent_module": "System"
    },
    {
      "id": "ClassifyRisk",
      "kind": "function",
      "name": "ClassifyRisk",
      "responsibility": "Classify risk by minimum TTC into no risk (>3.0 s), caution (1.5-3.0 s) and critical (<=1.5 s); raise warning for caution and critical.",
      "inputs": [
        {
          "name": "ttc_values",
          "source": ""
        },
        {
          "name": "traffic_rules",
          "source": ""
        }
      ],
      "outputs": [
        {
          "name": "risk_level",
          "consumers": []
        },
        {
          "name": "warning",
          "consumers": []
        }
      ],
      "stores_read": [],
      "stores_written": [],
      "preconditions": [
        "ttc_values.min_ttc>=0 and traffic_rules.speed_limit>0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "risk_level.risk_value>=0"
        },
        {
          "guard": "ttc_values.min_ttc>3.0",
          "effect": "risk_level.risk_type=0 and warning.warn_active=0"
        },
        {
          "guard": "ttc_values.min_ttc<=3.0 and ttc_values.min_ttc>1.5",
          "effect": "risk_level.risk_type=1 and warning.warn_active=1"
        },
        {
          "guard": "ttc_values.min_ttc<=1.5",
          "effect": "risk_level.risk_type=2 and warning.warn_active=1"
        }
      ],
      "quantified": false,
      "invariants": [],
      "notes": "extracted from validated SOFL artifacts",
      "level": "L1",
      "parent_module": "System"
    },
    {
      "id": "PlanManeuver",
      "kind": "function",
      "name": "PlanManeuver",
      "responsibility": "Produce cruise for no risk, deceleration for caution, and emergency deceleration (>=6.0 m/s2, target speed 0) for critical; driver acceleration request cannot override emergency braking.",
      "inputs": [
        {
          "name": "risk_level",
          "source": ""
        },
        {
          "name": "ego_state",
          "source": ""
        },
        {
          "name": "driver_intent",
          "source": ""
        },
        {
          "name": "route",
          "source": ""
        },
        {
          "name": "map_data",
          "source": ""
        }
      ],
      "outputs": [
        {
          "name": "maneuver",
          "consumers": []
        }
      ],
      "stores_read": [],
      "stores_written": [],
      "preconditions": [
        "risk_level.risk_value>=0 and ego_state.speed>=0 and ego_state.speed<=130.0 and driver_intent.cruise_speed>=0 and route.path_length>0 and map_data.speed_limit>=0"
      ],
      "postconditions": [
        {
          "guard": "true",
          "effect": "maneuver.target_speed>=0 and maneuver.decel_req>=0"
        },
        {
          "guard": "risk_level.risk_type=0",
          "effect": "maneuver.maneuver_type=1 and maneuver.target_speed<=map_data.speed_limit"
        },
        {
          "guard": "risk_level.risk_type=1",
          "effect": "maneuver.maneuver_type=2 and maneuver.decel_req>0"
        },
        {
          "guard": "risk_level.risk_type=2",
          "effect": "maneuver.maneuver_type=3 and maneuver.decel_req>=6.0 and maneuver.target_speed=0"
        },
        {
          "guard": "driver_intent.intent_type=2 and risk_level.risk_type<2",
          "effect": "maneuver.maneuver_type=1"
        }
      ],
      "quantified": true,
      "invariants": [],
      "notes": "extracted from validated SOFL artifacts",
      "level": "L1",
      "parent_module": "System"
    }
  ],
